{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.local/governance/cam.schema.json",
  "title": "RealityCheck Claim Authority Registry",
  "type": "object",
  "required": [
    "policy_version",
    "claims"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "family",
          "normative_level"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "normative_level": {
            "enum": [
              "ALLOW",
              "ALLOW_WITH_WARNING",
              "MANDATORY",
              "CONDITIONAL",
              "PERMANENTLY_BLOCKED"
            ]
          },
          "requires_evidence": {
            "type": "array"
          },
          "requires_state": {
            "type": "object"
          },
          "template": {
            "type": "object"
          },
          "mandatory_companions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gp_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}