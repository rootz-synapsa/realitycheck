{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.local/governance/cam.schema.json",
  "title": "Claim Assessment Message (CAM)",
  "type": "object",
  "required": ["claim_id", "evidence"],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
